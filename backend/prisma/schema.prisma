
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"

}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}


model News {
  id   Int    @id @default(autoincrement())
  nepaliDescription String?          @db.Text 
  imageUrl          String       
  url               String          @unique 
  englishTitle      String?
  nepaliTitle      String?
  englishDescription String?        @db.Text
  dateEnglish String?
  timeEnglish String?
  dateNepali String?
  timeNepali String?
  sharedTime String?
  category          Category
  publisher         Publisher @relation(fields: [publisherId], references: [id])
  publisherId       String
  isTrending        Boolean   @default(false) 
  publishedAt       DateTime?
  scrapedAt         DateTime  @default(now()) 
}

model Publisher {
  id          String @id @default(cuid())
  name        String @unique    
  logoUrl     String? 
  news        News[]
}



enum Category {
  BUSINESS
  ENTERTAINMENT
  SPORTS
  HEALTH
  EDUCATION
  TECHNOLOGY
  INTERNATIONAL
  MERO_SHARE
  GENERAL 
  TRENDING
  LIFESTYLE
  NATIONAL
  OPINION
  POLITICS
}