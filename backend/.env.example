# App (3001 so it doesn't clash with frontend Next.js on 3000)
NODE_ENV="development"
PORT=3001
# Comma-separated extra origins allowed by CORS (local dev already allowed by default)
FRONTEND_URL="http://localhost:3000"


DATABASE_URL="mysql://:newsapiastavisio_abi:NewsAstaVisionApi73123@138.199.140.147:3306/newsapiastavisio_newsdb"

# Scraper trigger (required in production for POST /api/scraper/start)
SCRAPE_SECRET_KEY="change-me-to-a-long-random-string"
# Shared secret for the news API: the frontend sends this as the x-api-key
# header on every /api/news call. REQUIRED in production (server refuses to
# boot without it). Must exactly match frontend NEXT_PUBLIC_API_KEY.
# NOTE: it ships in frontend JS, so it deters hotlinking/abuse — it is not
# a bulletproof secret against someone reading browser devtools.
API_KEY="change-me-to-a-long-random-string"
# Set to "true" to turn off the in-app hourly scheduler (do this only if you
# trigger scrapes from cPanel Cron Jobs instead, otherwise you'll get double runs)
DISABLE_SCHEDULER="false"


